# Copy to /srv/llm/.env and fill in on the host (chmod 600).
# Never commit real values. Variable names only:
LLAMA_API_KEY=
LITELLM_MASTER_KEY=
# SearXNG instance secret. Leave empty here: ops/llm/apply.sh generates it
# into /srv/llm/.env (0600) if missing. Never commit the value.
SEARXNG_SECRET=

# Served GGUFs. Swapping a model = set these, then run ops/llm/apply.sh --yes.
# Unset values fall back to the defaults in compose.yaml.
# MAIN_MODEL_FILE is the in-container path; /srv/models/huggingface is
# mounted at /root/.cache/huggingface.
# MAIN_MODEL_FILE=/root/.cache/huggingface/<dir>/<model>.gguf
# MAINT_MODEL_DIR is the host dir mounted at /models (must be absolute).
# MAINT_MODEL_DIR=/home/you/models/ornith
# MAINT_MODEL_FILE is the filename inside that dir.
# MAINT_MODEL_FILE=/models/<model>.gguf
