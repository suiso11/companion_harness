{
  "name": "@companion/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "prestart": "node scripts/build-ui.mjs",
    "dev": "tsx watch src/index.ts",
    "predev": "node scripts/build-ui.mjs",
    "backup": "tsx src/cli.ts backup",
    "set-password": "tsx src/cli.ts set-password",
    "supervise": "tsx src/supervisor_cli.ts",
    "build:ui": "node scripts/build-ui.mjs",
    "e2e:serve": "node --import tsx e2e/server.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test": "vitest run",
    "smoke:startup": "vitest run --config pnpm-smoke.startup.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src",
    "learning": "tsx src/learning_cli.ts",
    "agora": "tsx src/agora_cli.ts",
    "records": "tsx src/records_cli.ts",
    "compare": "tsx src/compare_cli.ts",
    "message": "tsx src/companion_message_cli.ts"
  },
  "dependencies": {
    "@companion/connector-markdown": "workspace:*",
    "@companion/contracts": "workspace:*",
    "@companion/kernel": "workspace:*",
    "@companion/model-local": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.5",
    "zod": "4.5.4",
    "@companion/connector-calendar": "workspace:*",
    "@companion/connector-mcp": "workspace:*",
    "@companion/connector-web": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.12.4",
    "better-sqlite3": "13.0.3",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": "26.12.0",
    "pnpm": "11.25.0"
  }
}
